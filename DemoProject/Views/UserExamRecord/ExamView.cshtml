@using System.Web.Helpers
@{
    ViewBag.Title = "ExamView";
    Layout = null;
}

@model DemoProject.Models.UserExamViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Exam View</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        .disabled-email,
        .disabled-field {
            background-color: #e9ecef !important;
            color: #6c757d !important;
            border: 1px solid #ced4da;
            cursor: not-allowed;
        }
        #questionPalette .btn {
            width: 40px;
            height: 40px;
            margin: 2px;
        }

        #examContainer {
            height: 100vh;
            overflow: hidden;
        }

            #examContainer .d-flex.flex-grow-1 {
                overflow: hidden;
            }

        #questionContainer {
            overflow-y: auto;
        }

        .question-status-legend {
            font-size: 0.9rem;
        }

            .question-status-legend .btn {
                pointer-events: none;
            }
    </style>
</head>
<body>


    <div id="userDetailsModal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-3">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Start Your Exam</h5>
                </div>
                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="fw-bold">Email</label>
                            <input type="email" class="form-control disabled-field mb-3" value="@Model.Email" readonly>

                            <label class="fw-bold">Name</label>
                            <input type="text" class="form-control mb-3 @((Model.ExamStatus == "INPROGRESS") ? "disabled-field" : "")" id="name" value="@Model.Name" @(Model.ExamStatus == "INPROGRESS" ? "readonly" : "")>

                            <label class="fw-bold">Username</label>
                            <input type="text" class="form-control @((Model.ExamStatus == "INPROGRESS") ? "disabled-field" : "")" id="username" value="@Model.UserName" @(Model.ExamStatus == "INPROGRESS" ? "readonly" : "")>
                        </div>

                        <div class="col-md-6">
                            <div class="card shadow-sm border-0 rounded-3 bg-light p-3">
                                <div class="card-body">
                                    <h6 class="fw-bold text-primary mb-3">
                                        <i class="fas fa-file-alt me-2"></i> Paper Set Details
                                    </h6>
                                    <p><i class="fas fa-book me-2 text-dark"></i> <strong>Paper Set:</strong> @Model.PaperSetName</p>
                                    <p><i class="fas fa-star me-2 text-warning"></i> <strong>Total Marks:</strong> @Model.TotalMarks</p>
                                    <p><i class="fas fa-clock me-2 text-danger"></i> <strong>Duration:</strong> @Model.DurationInMinutes mins</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h6 class="fw-bold text-info">Exam Instructions</h6>
                        <ul>
                            <li>Please read all the questions carefully before answering.</li>
                            <li>Choose the correct option(s) for multiple choice questions.</li>
                            <li>For descriptive questions, provide your answer in the text area.</li>
                            <li>Once you start the exam, the timer will begin, and you will be given a set time to complete it.</li>
                            <li>If you are unsure about any question, you can skip it and revisit it later.</li>
                            <li>Your answers will be saved automatically as you proceed through the exam.</li>
                            <li>Make sure to submit the exam before the time runs out.</li>
                        </ul>
                    </div>

                </div>
                <div class="modal-footer bg-light">

                    @if (Model.ExamStatus == "INPROGRESS")
                    {
                        <div class="me-auto text-warning">
                            <h5><strong>You already started the exam. You can continue by this button.</strong></h5>
                        </div>
                    }

                    <button type="button" class="btn btn-secondary px-4 me-2" id="continueExamBtn" style="display: none;">Continue Exam</button>
                    <button type="button" class="btn btn-primary px-4" id="startExamBtn" @(Model.ExamStatus == "INPROGRESS" ? "disabled" : "")>Submit & Start Test</button>
                </div>
            </div>
        </div>
    </div>



    <div id="examContainer" class="d-flex flex-column min-vh-100" style="display: none;">
        <div class="header p-4 bg-light d-flex justify-content-between align-items-center shadow-sm rounded-3">
            <div>
                <h5 class="fw-bold text-primary">Exam</h5>
                <p class="mb-0"><b>@Model.PaperSetName</b></p>
            </div>
            <div>
                <h5 class="fw-bold text-primary">Total Marks</h5>
                <p class="mb-0"><b>@Model.TotalMarks</b></p>
            </div>
            <div>
                <h5 class="fw-bold text-primary">Duration</h5>
                <p class="mb-0"><b>@Model.DurationInMinutes mins</b></p>
            </div>
            <div>
                <h4 id="examTimer" class="text-danger fw-semibold fs-5">Time Left: @Model.DurationInMinutes:00</h4>
            </div>
        </div>

        <div class="d-flex flex-grow-1">
            <div class="w-75 d-flex flex-column">
                <div id="questionContainer" class="p-3 flex-grow-1">
                    <h5 id="questionText"></h5>
                    <img id="questionImage" class="img-fluid mt-2" style="display: none;">
                    <div id="optionsContainer" class="mt-3"></div>
                </div>

                <div class="footer p-3 bg-light d-flex justify-content-end mt-auto mb-4">
                    <button class="btn btn-outline-secondary btn-lg me-2" id="prevQuestion">Previous</button>
                    <button class="btn btn-primary btn-lg me-2" id="nextQuestion">Next</button>
                    <button class="btn btn-danger btn-lg" id="finishExam">Finish</button>
                </div>
            </div>

            <div class="w-25 p-3 bg-light border-start">
                <h5 class="mb-3">Question Palette</h5>
                <div id="questionPalette" class="d-flex flex-wrap gap-2"></div>


                <div class="question-status-legend mt-3 p-3 bg-white border rounded">
                    <h6 class="mb-3">Question Status Legend</h6>
                    <div class="d-flex flex-column">
                        <div class="d-flex align-items-center mb-2">
                            <span class="btn btn-sm btn-primary me-2" style="width: 30px; height: 30px;"></span>
                            <span>Current Question</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="btn btn-sm btn-outline-secondary me-2" style="width: 30px; height: 30px;"></span>
                            <span>Not Answered</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="btn btn-sm btn-warning me-2" style="width: 30px; height: 30px;"></span>
                            <span>Visited Questions</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="btn btn-sm btn-success me-2" style="width: 30px; height: 30px;"></span>
                            <span>Answered</span>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>




    <div class="modal fade" id="finishExamConfirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">Confirm Exam Submission</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <strong>Are you sure you want to finish the exam?</strong>
                    </div>
                    <div class="mb-3">
                        <h6>Exam Summary:</h6>
                        <p id="examSummaryText"></p>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="confirmSubmission">
                        <label class="form-check-label" for="confirmSubmission">
                            I confirm that I have answered all important questions
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmFinishExamBtn" disabled>Submit Exam</button>
                </div>
            </div>
        </div>
    </div>





    <script>
    let questions = @Html.Raw(Json.Encode(Model.Questions));
    let userExamModel = @Html.Raw(Json.Encode(Model));
        let currentIndex = 0;
        let remainingTime;

    $(document).ready(function () {
    $('#userDetailsModal').modal('show');

        let startTimeString = '@Model.StartTime.ToString()';
        let dateParts = startTimeString.split(' ');
        let date = dateParts[0].split('-');
        let time = dateParts[1];
        let isoDateString = `${date[2]}-${date[1]}-${date[0]}T${time}`;
        let startTime = new Date(isoDateString);
        let currentTime = new Date();
    let usedMinutes = Math.floor((currentTime - startTime) / 60000);
     remainingTime = Math.max(@Model.DurationInMinutes - usedMinutes, 0);


    if ('@Model.ExamStatus' === "INPROGRESS") {
        $('#continueExamBtn').show();
        $('#startExamBtn').hide();
        $('#userDetailsModal').modal('hide');
        $('#examContainer').show();
        //startTimer(remainingTime);
        loadQuestion();
    }else if ('@Model.ExamStatus' === "COMPLETED") {
        window.location.href = '@Url.Action("SubmissionSuccess", "UserExamRecord", new { examId = @Model.UserExamRecordId })';
    }
});

    $('#continueExamBtn').click(function () {
            $('#userDetailsModal').modal('hide');
            $('#examContainer').show();
            startTimer(remainingTime);
        loadQuestion();
        checkAllQuestionsVisited();
        });

    $('#startExamBtn').click(function () {
        let userData = {
            userExamRecordId: userExamModel.UserExamRecordId,
            name: $('#name').val(),
            username: $('#username').val(),
            paperSetId: userExamModel.PaperSetId,
            userId: userExamModel.UserId
        };


        $.post('/UserExamRecord/StartExam', userData, function (response) {
            if (response.success) {
                $('#userDetailsModal').modal('hide');
                $('#examContainer').show();
                startTimer(@Model.DurationInMinutes);
                loadQuestion();
            } else {
                alert('Error starting the exam. Please try again.');
            }
        });
        checkAllQuestionsVisited();
    });

        function loadQuestion() {
            let q = questions[currentIndex];

            $('#questionText').html(`<strong>Question ${currentIndex + 1}:</strong> ${q.QuestionText} <strong>(Marks: ${q.DefaultMarks})</strong>`);

            $('#optionsContainer').empty();

            if (q.Image && q.Image.trim() !== "") {
                $('#questionImage').attr('src', "/Content/QuestionImages/" + q.Image).show();
            } else {
                $('#questionImage').hide();
            }

            if (!userExamModel.Answers) {
                userExamModel.Answers = [];
            }

            let existingAnswer = userExamModel.Answers.find(a => a.QuestionId === q.Id);
            if (!existingAnswer) {
                existingAnswer = { UserExamRecordId: userExamModel.UserExamRecordId, QuestionId: q.Id, SelectedOptions: [], DescriptiveAnswer: '' };
                userExamModel.Answers.push(existingAnswer);
            }

            if (q.QuestionTypeId === 1) {
                $('#optionsContainer').html(q.options.map(o =>
                    `<div class="form-check">
                <input class="form-check-input" type="radio" name="option" value="${o.Id}" ${existingAnswer.SelectedOptions.includes(o.Id) ? 'checked' : ''}>
                <label class="form-check-label">${o.OptionText}</label>
            </div>`).join(''));
            } else if (q.QuestionTypeId === 2) {
                $('#optionsContainer').html(q.options.map(o =>
                    `<div class="form-check">
                <input class="form-check-input" type="checkbox" name="option" value="${o.Id}" ${existingAnswer.SelectedOptions.includes(o.Id) ? 'checked' : ''}>
                <label class="form-check-label">${o.OptionText}</label>
            </div>`).join(''));
            } else {
                $('#optionsContainer').html(`<textarea class="form-control" id="descriptiveAnswer">${existingAnswer.DescriptiveAnswer || ''}</textarea>`);
            }
            updateQuestionPalette();
        }

        function updateQuestionPalette() {
            let paletteHtml = questions.map((q, index) => {
                let existingAnswer = userExamModel.Answers.find(a => a.QuestionId === q.Id);

                
                let statusClass = 'btn-outline-secondary'; 
                if (index === currentIndex) {
                    statusClass = 'btn-primary'; 
                } else if (existingAnswer) {
                    if (existingAnswer.SelectedOptions.length > 0 || existingAnswer.DescriptiveAnswer) {
                        statusClass = 'btn-success'; 
                    } else {
                        statusClass = 'btn-warning'; 
                    }
                }

                return `<button class="btn ${statusClass} btn-sm" data-question-index="${index}">${index + 1}</button>`;
            }).join('');

            $('#questionPalette').html(paletteHtml);

            
            $('#questionPalette .btn').click(function () {
                let targetIndex = $(this).data('question-index');
                saveAnswer(function () {
                    currentIndex = targetIndex;
                    loadQuestion();
                    checkAllQuestionsVisited();
                });
            });
        }


        function checkAllQuestionsVisited() {
            let visitedQuestions = new Set();

            $('#questionPalette .btn').each(function () {
                if ($(this).hasClass('btn-success') || $(this).hasClass('btn-warning') || $(this).hasClass('btn-primary')) {
                    visitedQuestions.add(parseInt($(this).text()) - 1);
                }
            });

            let allQuestionsVisited = visitedQuestions.size === questions.length;
            $('#finishExam').prop('disabled', !allQuestionsVisited);
        }


    $('#prevQuestion').click(function () {
        if (currentIndex > 0) {
            saveAnswer(function () {
                currentIndex--;
                loadQuestion();
                checkAllQuestionsVisited();
            });
        }
    });

    $('#nextQuestion').click(function () {
        if (currentIndex < questions.length - 1) {
            saveAnswer(function () {
                currentIndex++;
                loadQuestion();
                checkAllQuestionsVisited();
            });
        }
    });

        $('#finishExam').prop('disabled', true);

        $('#finishExam').click(function () {
            // Calculate exam summary
            let totalQuestions = questions.length;
            let answeredQuestions = userExamModel.Answers.filter(a =>
                a.SelectedOptions.length > 0 || (a.DescriptiveAnswer && a.DescriptiveAnswer.trim() !== '')
            ).length;
            let unansweredQuestions = totalQuestions - answeredQuestions;

            $('#examSummaryText').html(`
        <strong>Total Questions:</strong> ${totalQuestions}<br>
        <strong>Answered Questions:</strong> ${answeredQuestions}<br>
        <strong>Unanswered Questions:</strong> ${unansweredQuestions}
    `);

            let finishExamConfirmModal = new bootstrap.Modal('#finishExamConfirmModal');
            finishExamConfirmModal.show();
        });

        $('#confirmSubmission').change(function () {
            $('#confirmFinishExamBtn').prop('disabled', !this.checked);
        });

        $('#confirmFinishExamBtn').click(function () {
            saveAnswer(function () {
                $.post('/UserExamRecord/FinishExam', userExamModel, function (response) {
                    if (response.success) {
                        window.location.href = response.redirectUrl; // Redirect to the success page
                    } else {
                        alert(response.message || 'Error finishing the exam. Please try again.');
                    }
                }).fail(function () {
                    alert('Something went wrong. Please try again.');
                });
            });
        });


    function saveAnswer(callback) {
        let q = questions[currentIndex];
        let existingAnswer = userExamModel.Answers.find(a => a.QuestionId === q.Id) || { UserExamRecordId: userExamModel.UserExamRecordId, QuestionId: q.Id, SelectedOptions: [], DescriptiveAnswer: '' };

        if (q.QuestionTypeId === 1) { // Single choice
            existingAnswer.SelectedOptions = [$('input[name="option"]:checked').val()].filter(v => v);
        } else if (q.QuestionTypeId === 2) { // Multiple choice
            existingAnswer.SelectedOptions = $('input[name="option"]:checked').map(function () { return this.value; }).get();
        } else { // Descriptive answer
            existingAnswer.DescriptiveAnswer = $('#descriptiveAnswer').val();
        }

        if (!userExamModel.Answers.some(a => a.QuestionId === q.Id)) {
            userExamModel.Answers.push(existingAnswer);
        }

        $.ajax({
            url: '/UserExamRecord/SaveAnswer',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(userExamModel),
            success: function (response) {
                if (response.success) {
                    userExamModel = response.updatedModel;
                    updateQuestionPalette();// Update model with new data
                    if (callback) callback();
                } else {
                    alert('Error saving answer.');
                }
            }
        });
    }

        function startTimer(durationInMinutes) {
            let timeLeft = durationInMinutes * 60;
            let timerInterval = setInterval(function () {
                let minutes = Math.floor(timeLeft / 60);
                let seconds = timeLeft % 60;
                $('#examTimer').text(`Time Left: ${minutes}:${seconds < 10 ? '0' + seconds : seconds}`);

                if (timeLeft-- <= 0) {
                    clearInterval(timerInterval);
                    showTimeoutSubmissionModal();
                }
            }, 1000);
        }

        function showTimeoutSubmissionModal() {
            let timeoutModalHtml = `
    <div class="modal fade" id="examTimeoutModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Exam Time Expired</h5>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <strong>Your exam time has expired.</strong>
                    </div>
                    <div class="mb-3">
                        <h6>Exam Summary:</h6>
                        <p id="timeoutExamSummaryText"></p>
                    </div>
                    <div class="text-center mt-3">
                        <h4 class="text-danger">Auto Submit in: <span id="autoSubmitCountdown">1:00</span></h4>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" id="timeoutConfirmFinishExamBtn">Submit Exam</button>
                </div>
            </div>
        </div>
    </div>`;

            
            if ($('#examTimeoutModal').length === 0) {
                $('body').append(timeoutModalHtml);
            }

           
            let totalQuestions = questions.length;
            let answeredQuestions = userExamModel.Answers.filter(a =>
                a.SelectedOptions.length > 0 || (a.DescriptiveAnswer && a.DescriptiveAnswer.trim() !== '')
            ).length;
            let unansweredQuestions = totalQuestions - answeredQuestions;

           
            $('#timeoutExamSummaryText').html(`
        <strong>Total Questions:</strong> ${totalQuestions}<br>
        <strong>Answered Questions:</strong> ${answeredQuestions}<br>
        <strong>Unanswered Questions:</strong> ${unansweredQuestions}
    `);

            
            let timeoutModal = new bootstrap.Modal('#examTimeoutModal', {
                backdrop: 'static',
                keyboard: false
            });
            timeoutModal.show();

            
            let timeLeft = 60;
            let countdownInterval = setInterval(function () {
                let minutes = Math.floor(timeLeft / 60);
                let seconds = timeLeft % 60;
                $('#autoSubmitCountdown').text(`${minutes}:${seconds < 10 ? '0' + seconds : seconds}`);

                if (timeLeft-- <= 0) {
                    clearInterval(countdownInterval);
                    $('#timeoutConfirmFinishExamBtn').click();
                }
            }, 1000);

            
            $('#timeoutConfirmFinishExamBtn').off('click').on('click', function () {
                clearInterval(countdownInterval); 
                saveAnswer(function () {
                    $.post('/UserExamRecord/FinishExam', userExamModel, function (response) {
                        if (response.success) {
                            window.location.href = response.redirectUrl;
                        } else {
                            alert(response.message || 'Error finishing the exam. Please try again.');
                        }
                    }).fail(function () {
                        alert('Something went wrong. Please try again.');
                    });
                });
            });
        }

    </script>

</body>
</html>

