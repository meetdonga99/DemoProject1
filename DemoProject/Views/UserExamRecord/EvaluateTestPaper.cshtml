@using System.Web.Helpers
@{
    ViewBag.Title = "Exam Evaluation";
    Layout = null;
}

@model DemoProject.Models.UserExamViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Exam Evaluation</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <style>
        .disabled-email,
        .disabled-field {
            background-color: #e9ecef !important;
            color: #6c757d !important;
            border: 1px solid #ced4da;
            cursor: not-allowed;
        }

        #questionPalette .btn {
            width: 40px;
            height: 40px;
            margin: 2px;
        }

        #examContainer {
            height: 100vh;
            overflow: hidden;
        }

            #examContainer .d-flex.flex-grow-1 {
                overflow: hidden;
            }

        #questionContainer {
            overflow-y: auto;
        }

        .question-status-legend {
            font-size: 0.9rem;
        }

            .question-status-legend .btn {
                pointer-events: none;
            }

        .correct-option {
            background-color: #d4edda;
            border-color: #c3e6cb;
        }

        .incorrect-option {
            background-color: #f8d7da;
            border-color: #f5c6cb;
        }

        .correct-mark {
            color: green;
            margin-left: 10px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div id="examContainer" class="d-flex flex-column min-vh-100">
        <div class="header p-4 bg-light d-flex justify-content-between align-items-center shadow-sm rounded-3">
            <div>
                <h5 class="fw-bold text-primary">Exam Evaluation</h5>
                <p class="mb-0"><b>@Model.PaperSetName</b></p>
            </div>
            <div>
                <h5 class="fw-bold text-primary">Total Marks</h5>
                <p class="mb-0"><b>@Model.TotalMarks</b></p>
            </div>
            <div>
                <h5 class="fw-bold text-primary">Student Details</h5>
                <p class="mb-0"><b>Name: @Model.Name</b></p>
                <p class="mb-0"><b>Email: @Model.Email</b></p>
            </div>
        </div>

        <div class="d-flex flex-grow-1">
            <div class="w-75 d-flex flex-column">
                <div id="questionContainer" class="p-3 flex-grow-1">
                    <h5 id="questionText"></h5>
                    <img id="questionImage" class="img-fluid mt-2" style="display: none;">
                    <div id="optionsContainer" class="mt-3"></div>
                </div>

                <div class="footer p-3 bg-light d-flex justify-content-between mt-auto mb-4">
                    <div class="obtained-marks">
                        <h5>Obtained Marks: <span id="totalObtainedMarks">0</span> / <span id="totalMarks">@Model.TotalMarks</span></h5>
                    </div>
                    <div class="navigation-buttons">
                        <button class="btn btn-outline-secondary btn-lg me-2" id="prevQuestion">Previous</button>
                        <button class="btn btn-primary btn-lg me-2" id="nextQuestion">Next</button>
                        <button class="btn btn-success btn-lg" id="submitEvaluation">Submit Evaluation</button>
                    </div>
                </div>
            </div>

            <div class="w-25 p-3 bg-light border-start">
                <h5 class="mb-3">Question Palette</h5>
                <div id="questionPalette" class="d-flex flex-wrap gap-2"></div>

                <div class="question-status-legend mt-3 p-3 bg-white border rounded">
                    <h6 class="mb-3">Question Status Legend</h6>
                    <div class="d-flex flex-column">
                        <div class="d-flex align-items-center mb-2">
                            <span class="btn btn-sm btn-primary me-2" style="width: 30px; height: 30px;"></span>
                            <span>Current Question</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="btn btn-sm btn-success me-2" style="width: 30px; height: 30px;"></span>
                            <span>Evaluated Correct</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="btn btn-sm btn-danger me-2" style="width: 30px; height: 30px;"></span>
                            <span>Evaluated Incorrect</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="btn btn-sm btn-warning me-2" style="width: 30px; height: 30px;"></span>
                            <span>Not Evaluated</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    let questions = @Html.Raw(Json.Encode(Model.Questions));
    let userExamModel = @Html.Raw(Json.Encode(Model));
    let currentIndex = 0;

    // Temporary correct answers data (this would typically come from server)
        let correctAnswersData = @Html.Raw(Json.Encode(TempData["CorrectAnswers"]));
        console.log("shdshdjks", correctAnswersData);

    $(document).ready(function () {
        loadQuestion();
        updateTotalObtainedMarks();
    });

    function loadQuestion() {
        let q = questions[currentIndex];
        let correctAnswer = correctAnswersData ? correctAnswersData.find(ca => ca.QuestionId === q.Id) : null;

        $('#questionText').html(`<strong>Question ${currentIndex + 1}:</strong> ${q.QuestionText} <strong>(Marks: ${q.DefaultMarks})</strong>`);

        $('#optionsContainer').empty();

        if (q.Image && q.Image.trim() !== "") {
            $('#questionImage').attr('src', "/Content/QuestionImages/" + q.Image).show();
        } else {
            $('#questionImage').hide();
        }

        let existingAnswer = userExamModel.Answers.find(a => a.QuestionId === q.Id);

        if (q.QuestionTypeId === 1 || q.QuestionTypeId === 2) { // Single or Multiple choice
            $('#optionsContainer').html(q.options.map(o => {
                let isSelected = existingAnswer && existingAnswer.SelectedOptions.includes(o.Id);
                let isCorrect = correctAnswer && correctAnswer.CorrectOptions.includes(o.Id);

                let optionClass = '';
                if (isSelected && isCorrect) {
                    optionClass = 'correct-option';
                } else if (isSelected && !isCorrect) {
                    optionClass = 'incorrect-option';
                }

                return `
                <div class="form-check ${optionClass}">
                    <input class="form-check-input" type="${q.QuestionTypeId === 1 ? 'radio' : 'checkbox'}"
                           name="option"
                           value="${o.Id}"
                           ${isSelected ? 'checked' : ''}
                           disabled
                    >
                    <label class="form-check-label">
                        ${o.OptionText}
                        ${isCorrect ? '<i class="fas fa-check text-success correct-mark"></i>' : ''}
                    </label>
                </div>`;
            }).join(''));

            // Auto-mark for MCQ
            if (correctAnswer) {
                let obtainedMarks = 0;
                if (JSON.stringify(existingAnswer.SelectedOptions.sort()) === JSON.stringify(correctAnswer.CorrectOptions.sort())) {
                    obtainedMarks = q.DefaultMarks;
                }
                existingAnswer.ObtainedMarks = obtainedMarks;
            }
        } else { // Descriptive answer
            $('#optionsContainer').html(`
                <textarea class="form-control" id="descriptiveAnswer" readonly>${existingAnswer.DescriptiveAnswer || ''}</textarea>
                <div class="mt-3">
                    <label for="manualMarks" class="form-label">Marks Obtained</label>
                    <input type="number" class="form-control" id="manualMarks"
                           max="${q.DefaultMarks}"
                           value="${existingAnswer.ObtainedMarks || 0}"
                           onchange="updateDescriptiveMarks(this.value)"
                    >
                    <small class="text-muted">Max Marks: ${q.DefaultMarks}</small>
                </div>
            `);
        }

        updateQuestionPalette();
    }

    function updateDescriptiveMarks(marks) {
        let q = questions[currentIndex];
        let existingAnswer = userExamModel.Answers.find(a => a.QuestionId === q.Id);
        existingAnswer.ObtainedMarks = parseFloat(marks);
        updateTotalObtainedMarks();
        updateQuestionPalette();
    }

    function updateQuestionPalette() {
        let paletteHtml = questions.map((q, index) => {
            let existingAnswer = userExamModel.Answers.find(a => a.QuestionId === q.Id);

            let statusClass = 'btn-warning'; // Not evaluated
            if (index === currentIndex) {
                statusClass = 'btn-primary'; // Current question
            } else if (existingAnswer && existingAnswer.ObtainedMarks !== undefined) {
                statusClass = existingAnswer.ObtainedMarks > 0 ? 'btn-success' : 'btn-danger';
            }

            return `<button class="btn ${statusClass} btn-sm" data-question-index="${index}">${index + 1}</button>`;
        }).join('');

        $('#questionPalette').html(paletteHtml);

        $('#questionPalette .btn').click(function () {
            let targetIndex = $(this).data('question-index');
            currentIndex = targetIndex;
            loadQuestion();
        });
    }

    function updateTotalObtainedMarks() {
        let totalObtained = userExamModel.Answers.reduce((sum, answer) =>
            sum + (answer.ObtainedMarks || 0), 0);
        $('#totalObtainedMarks').text(totalObtained.toFixed(2));
    }

    $('#prevQuestion').click(function () {
        if (currentIndex > 0) {
            currentIndex--;
            loadQuestion();
        }
    });

    $('#nextQuestion').click(function () {
        if (currentIndex < questions.length - 1) {
            currentIndex++;
            loadQuestion();
        }
    });

    $('#submitEvaluation').click(function () {
        // Send evaluation data to server
        $.ajax({
            url: '/UserExamRecord/SubmitEvaluation',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(userExamModel),
            success: function (response) {
                if (response.success) {
                    alert('Evaluation submitted successfully');
                    window.location.href = response.redirectUrl;
                } else {
                    alert('Error submitting evaluation');
                }
            },
            error: function () {
                alert('Something went wrong. Please try again.');
            }
        });
    });
    </script>
</body>
</html>