@using DemoProject.Model
@using DemoProject.Helper

@{
    ViewBag.Title = "Import Results";
    string formCode = AuthorizeFormAccess.FormAccessCode.QUESTION.ToString();
    var formName = FormUtility.GetFormName(formCode);
    string parentFormname = FormUtility.GetParentFormName(formCode);

    int successCount = TempData["SuccessCount"] != null ? (int)TempData["SuccessCount"] : 0;
    int errorCount = TempData["ErrorCount"] != null ? (int)TempData["ErrorCount"] : 0;
    List<string> errorMessages = TempData["ErrorMessages"] as List<string> ?? new List<string>();
}

<div class="coman_content">
    <div class="subheader">
        <div class="left_title">
            <h2 class="mr-3">Import Results</h2>
            <div class="left breadcrumb_list">
                <ul>
                    <li><a href="@Url.Action("Index","Home")"><i class="fa fa-home"></i></a></li>
                    <li><a href="javascript:void(0)">@parentFormname</a></li>
                    <li><a href="@Url.Action("Index", "Question")">@formName</a></li>
                    <li>Import Results</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="common_white_box">
        <div class="row">
            <div class="col-md-12">
                <div class="alert @(errorCount > 0 ? "alert-warning" : "alert-success")">
                    <h4>Import Summary</h4>
                    <p>
                        <strong>Successfully imported: </strong> @successCount questions<br>
                        <strong>Failed to import: </strong> @errorCount questions
                    </p>
                </div>
            </div>
        </div>

        @if (errorMessages.Any())
        {
            <div class="row mt-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-danger text-white">
                            <h5>Error Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Error Message</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < errorMessages.Count; i++)
                                        {
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>@errorMessages[i]</td>
                                            </tr>
                                        }
                                    </tbody>
                                 </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row mt-4">
            <div class="col-md-12">
                <a href="@Url.Action("Index", "Question")" class="btn btn-primary">
                    <i class="fa fa-list"></i> Return to Questions List
                </a>
                <a href="@Url.Action("Import", "Question")" class="btn btn-secondary">
                    <i class="fa fa-upload"></i> Import More Questions
                </a>
            </div>
        </div>
    </div>
</div>