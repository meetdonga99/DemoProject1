@model DemoProject.Models.UserExamViewModel

<div class="exam-summary card mb-4">
    <div class="card-header">
        <h3>Exam Summary</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <p><strong>Start Time:</strong> @Model.StartTime.ToString()</p>
            </div>
            <div class="col-md-3">
                <p><strong>End Time:</strong> @Model.EndTime.ToString()</p>
            </div>
            <div class="col-md-3">
                <p><strong>Duration:</strong> @Model.DurationInMinutes minutes</p>
            </div>
            <div class="col-md-3">
                <p><strong>Score:</strong> @Model.Score / @Model.TotalMarks</p>
            </div>
        </div>
    </div>
</div>

@{
    var correctAnswers = TempData["CorrectAnswers"] as IEnumerable<DemoProject.Models.CorrectAnswer>;
}

<div class="questions-container">
    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        var question = Model.Questions[i];
        var userAnswer = Model.Answers.FirstOrDefault(a => a.QuestionId == question.Id);
        var correctAnswer = correctAnswers.FirstOrDefault(ca => ca.QuestionId == question.Id);

        <div class="question-card card mb-4">
            <div class="card-header d-flex justify-content-between">
                <h4>Question @(i + 1)</h4>
                <span class="marks">Marks: @question.DefaultMarks</span>
            </div>
            <div class="card-body">
                <div class="question-text mb-3">
                    @Html.Raw(question.QuestionText)
                </div>

                @if (question.mediaFiles != null && question.mediaFiles.Any())
                {
                    <div class="image-gallery mb-3">
                        @foreach (var mediaFile in question.mediaFiles)
                        {
                            <a href="@Url.Content("/Content/QuestionImages/"+mediaFile.MediaName)" data-fancybox="gallery-question-@question.Id" class="gallery-item">
                                <img src="@Url.Content("/Content/QuestionImages/"+mediaFile.MediaName)" class="gallery-thumbnail" alt="Question image">
                            </a>
                        }
                    </div>
                }


                @if (question.QuestionTypeId == 1) // Radio buttons (single choice)
                {
                    <div class="options-container">
                        @foreach (var option in question.options)
                        {
                            bool isSelected = userAnswer != null && userAnswer.SelectedOptions != null && userAnswer.SelectedOptions.Contains(option.Id);
                            bool isCorrect = correctAnswer != null && correctAnswer.CorrectOptions != null && correctAnswer.CorrectOptions.Contains(option.Id);
                            string optionClass = "";
                            string statusIcon = "";

                            if (isSelected && isCorrect)
                            {
                                optionClass = "correct-selected";
                                statusIcon = "<i class='fa fa-check-circle text-success'></i>";
                            }
                            else if (isSelected && !isCorrect)
                            {
                                optionClass = "incorrect-selected";
                                statusIcon = "<i class='fa fa-times-circle text-danger'></i>";
                            }
                            else if (!isSelected && isCorrect)
                            {
                                optionClass = "correct-not-selected";
                                statusIcon = "<i class='fa fa-check-circle text-warning'></i>";
                            }

                            <div class="option-item d-flex align-items-center @optionClass">
                                <div class="option-input mr-2">
                                    <input type="radio" id="option_@(option.Id)" name="question_@(question.Id)" value="@option.Id" @(isSelected ? "checked" : "") disabled />
                                </div>
                                <label for="option_@(option.Id)" class="option-label mb-0 flex-grow-1">@Html.Raw(option.OptionText)</label>
                                <div class="option-status ml-2">
                                    @Html.Raw(statusIcon)
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (question.QuestionTypeId == 2) // Checkboxes (multiple choice)
                {
                    <div class="options-container">
                        @foreach (var option in question.options)
                        {
                            bool isSelected = userAnswer != null && userAnswer.SelectedOptions != null && userAnswer.SelectedOptions.Contains(option.Id);
                            bool isCorrect = correctAnswer != null && correctAnswer.CorrectOptions != null && correctAnswer.CorrectOptions.Contains(option.Id);
                            string optionClass = "";
                            string statusIcon = "";

                            if (isSelected && isCorrect)
                            {
                                optionClass = "correct-selected";
                                statusIcon = "<i class='fa fa-check-circle text-success'></i>";
                            }
                            else if (isSelected && !isCorrect)
                            {
                                optionClass = "incorrect-selected";
                                statusIcon = "<i class='fa fa-times-circle text-danger'></i>";
                            }
                            else if (!isSelected && isCorrect)
                            {
                                optionClass = "correct-not-selected";
                                statusIcon = "<i class='fa fa-check-circle text-warning'></i>";
                            }

                            <div class="option-item d-flex align-items-center @optionClass">
                                <div class="option-input mr-2">
                                    <input type="checkbox" id="option_@(option.Id)" name="question_@(question.Id)" value="@option.Id" @(isSelected ? "checked" : "") disabled />
                                </div>
                                <label for="option_@(option.Id)" class="option-label mb-0 flex-grow-1">@Html.Raw(option.OptionText)</label>
                                <div class="option-status ml-2">
                                    @Html.Raw(statusIcon)
                                </div>
                            </div>
                        }
                    </div>
                }
                else // Descriptive (text area)
                {
                    <div class="descriptive-answer-container row">
                        <div class="col-md-6">
                            <div class="expected-answer mb-3">
                                <h5>Expected Answer:</h5>
                                <div class="answer-content">
                                    @if (question.options != null && question.options.Any())
                                    {
                                        foreach (var option in question.options)
                                        {
                                            <div class="expected-answer-item">@Html.Raw(option.OptionText)</div>
                                        }
                                    }
                                    else
                                    {
                                        <p>No expected answer provided</p>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">

                            <h5>User's Answer:</h5>
                            <div class="answer-content">
                                @Html.Raw(userAnswer?.DescriptiveAnswer ?? "No answer provided")
                            </div>

                        </div>
                    </div>
                }

                @if (userAnswer != null)
                {
                    <div class="obtained-marks mt-3 @(userAnswer.ObtainedMarks == question.DefaultMarks ? "full-marks" : userAnswer.ObtainedMarks > 0 ? "partial-marks" : "zero-marks")">
                        <strong>Marks Obtained:</strong>
                        <span class="marks-value">@userAnswer.ObtainedMarks / @question.DefaultMarks</span>
                    </div>
                }
            </div>
        </div>
    }
</div>


<style>
 
    .image-gallery {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 15px 0;
    }

    .gallery-thumbnail {
        width: 100px;
        height: 100px;
        object-fit: cover;
        cursor: pointer;
        border-radius: 4px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        transition: transform 0.2s;
    }

        .gallery-thumbnail:hover {
            transform: scale(1.05);
        }

    
    .fancybox-thumbs {
        background: rgba(0,0,0,0.8);
    }

    .fancybox-thumbs__list a::before {
        border-color: #ff5268;
    }

   
    .correct-selected {
        background-color: rgba(40, 167, 69, 0.1);
        border-left: 4px solid #28a745;
        padding-left: 10px;
    }

    .incorrect-selected {
        background-color: rgba(220, 53, 69, 0.1);
        border-left: 4px solid #dc3545;
        padding-left: 10px;
    }

    .correct-not-selected {
        background-color: rgba(255, 193, 7, 0.1);
        border-left: 4px solid #ffc107;
        padding-left: 10px;
    }

    .question-card {
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        margin-bottom: 1.5rem;
    }

    .option-item {
        padding: 10px;
        margin-bottom: 8px;
        border-radius: 4px;
        transition: background-color 0.2s;
    }

    .option-label {
        margin-left: 8px;
    }

    .marks {
        font-weight: bold;
        background: #f8f9fa;
        padding: 4px 10px;
        border-radius: 4px;
    }

    .user-answer {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 4px;
        border-left: 4px solid #6c757d;
        margin-top: 10px;
    }

    .obtained-marks {
        padding: 8px 15px;
        border-radius: 4px;
        display: inline-block;
        font-weight: 500;
    }

    .full-marks {
        background-color: rgba(40, 167, 69, 0.2);
        border-left: 4px solid #28a745;
    }

    .partial-marks {
        background-color: rgba(255, 193, 7, 0.2);
        border-left: 4px solid #ffc107;
    }

    .zero-marks {
        background-color: rgba(220, 53, 69, 0.2);
        border-left: 4px solid #dc3545;
    }

    .marks-value {
        font-weight: bold;
    }

    .option-status {
        min-width: 24px;
        text-align: center;
    }

    .descriptive-answer-container {
        margin-top: 15px;
    }

    .expected-answer, .user-answer {
        height: 100%;
    }

    .answer-content {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 4px;
        min-height: 150px;
        overflow-y: auto;
    }

    .expected-answer .answer-content {
        border-left: 4px solid #17a2b8;
    }

    .user-answer .answer-content {
        border-left: 4px solid #6c757d;
    }

    .expected-answer-item {
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px dashed #dee2e6;
    }

        .expected-answer-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<script>
    if (typeof jQuery === 'undefined') {
        document.write('<script src="https://code.jquery.com/jquery-3.6.0.min.js"><\/script>');
    }

    (function () {
        var checkFancybox = function () {
            if (typeof $.fn.fancybox === 'undefined') {
                if (!document.querySelector('link[href*="jquery.fancybox.min.css"]')) {
                    $('head').append('<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.css" />');
                }
                if (!document.querySelector('link[href*="jquery.fancybox.thumbs.css"]')) {
                    $('head').append('<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.thumbs.css" />');
                }

                $.getScript("https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.js")
                    .done(function () {
                        $.getScript("https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.thumbs.js")
                            .done(function () {
                                initializeFancybox();
                                if ($('.loader-container').length) {
                                    $('.loader-container').fadeOut();
                                }
                            });
                    });
            } else {
                initializeFancybox();
                if ($('.loader-container').length) {
                    $('.loader-container').fadeOut();
                }
            }
        };

        var initializeFancybox = function () {
            $('[data-fancybox^="gallery-question-"]').fancybox({
                buttons: [
                    "zoom",
                    "slideShow",
                    "fullScreen",
                    "close"
                ],
                loop: true,
                protect: true,
                thumbs: {
                    autoStart: true,
                    hideOnClose: true
                }
            });

            $(document).trigger('content-loaded');
        };

        if (document.readyState === "complete" || document.readyState === "interactive") {
            setTimeout(checkFancybox, 1);
        } else {
            document.addEventListener("DOMContentLoaded", checkFancybox);
        }
    })();

    $(document).ready(function () {
        if (window.parent && window.parent.hideLoader) {
            window.parent.hideLoader();
        }

        if (typeof hideLoader === 'function') {
            hideLoader();
        }

        $(document).trigger('partial-view-loaded');
        $('.loader-container, #pageLoader, .page-loader').fadeOut();
    });
</script>