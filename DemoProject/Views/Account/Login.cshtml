@model DemoProject.Models.LoginModel
@using System.Web;
@using System.Web.Optimization;
@{
    ViewBag.Title = "Log in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewBag.Title</title>

    <!-- BEGIN META -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="keywords" content="your,keywords">
    <meta name="description" content="Short explanation about this website">
    <!-- END META -->
    <!-- BEGIN STYLESHEETS -->
    <link href="~/Content/images/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #0a5ed3;
            --primary-hover: #0850b3;
            --secondary-color: #f9fafb;
            --text-color: #333;
            --light-text: #6b7280;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f9fafb;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }

        .login-container {
            height: 100vh;
            display: flex;
        }

        .login-image {
            flex: 1;
            background: url('../../Content/images/login2.jpg') no-repeat center/cover;
            display: none;
        }

        .login-form-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem;
        }

        .login-box {
            width: 100%;
            max-width: 450px;
            padding: 2rem;
            border-radius: 12px;
            background-color: white;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .logo {
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background-color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            margin-right: 8px;
        }

        .logo-square {
            width: 12px;
            height: 12px;
            background-color: white;
            margin: 2px;
        }

        .logo-text {
            font-weight: bold;
            font-size: 1.5rem;
            color: var(--text-color);
        }

        .login-header {
            margin-bottom: 2rem;
        }

        .login-header h2 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }

        .login-header p {
            color: var(--light-text);
            margin-bottom: 0;
        }

        .form-label {
            font-weight: 500;
            margin-bottom: 0.5rem;
            display: block;
            color: var(--text-color);
        }

        .form-control {
            padding: 0.8rem 1rem;
            border-radius: 8px;
            border: 1px solid #d1d5db;
            margin-bottom: 1.5rem;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(10, 94, 211, 0.2);
        }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            padding: 0.8rem 1rem;
            font-weight: 500;
            border-radius: 8px;
            width: 100%;
            margin-top: 1rem;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
            border-color: var(--primary-hover);
        }

        .btn-google {
            background-color: white;
            color: #333;
            border: 1px solid #d1d5db;
            padding: 0.8rem 1rem;
            font-weight: 500;
            border-radius: 8px;
            width: 100%;
            margin-top: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-google:hover {
            background-color: #f9fafb;
        }

        .google-icon {
            margin-right: 8px;
        }

        .form-check {
            margin-bottom: 1rem;
        }

        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        .forgot-password {
            text-align: right;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }

        .signup-text {
            text-align: center;
            margin-top: 1.5rem;
            color: var(--light-text);
        }

        .signup-link {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
        }

        .signup-link:hover {
            text-decoration: underline;
        }

        .field-validation-error {
            color: #dc3545;
            font-size: 0.875rem;
            display: block;
            margin-top: -1rem;
            margin-bottom: 1rem;
        }

        .alertmsg {
            display: block;
            padding: 0.75rem 1.25rem;
            margin-bottom: 1rem;
            border-radius: 8px;
            width: 100%;
        }

        .bg-success {
            background-color: #d1e7dd !important;
            color: #0f5132 !important;
            border: 1px solid #badbcc;
        }

        .bg-error {
            background-color: #f8d7da !important;
            color: #842029 !important;
            border: 1px solid #f5c2c7;
        }

        @@media (min-width: 992px) {
            .login-image {
                display: block;
            }
        }
    </style>
</head>

<body>
    <div class="login-container">
        <!-- Left side image -->
        <div class="login-image"></div>

        <!-- Right side login form -->
        <div class="login-form-container">
            <div class="login-box">
                <!-- Logo -->
                <div class="logo">
                    <div class="logo-icon">
                        <div class="d-flex flex-wrap">
                            <div class="logo-square"></div>
                            <div class="logo-square"></div>
                            <div class="logo-square"></div>
                            <div class="logo-square"></div>
                        </div>
                    </div>
                    <span class="logo-text">AIES</span>
                </div>

                <!-- Login Header -->
                <div class="login-header">
                    <h2>Welcome back</h2>
                    <p>Please enter your details</p>
                </div>

                <!-- Alert Messages -->
                @if (TempData["Success"] != null)
                {
                    <div class="alertmsg bg-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alertmsg bg-error">@TempData["Error"]</div>
                }

                @if (ViewData["ErrorMessage"] != null)
                {
                    <span class="field-validation-error">@ViewData["ErrorMessage"]</span>
                }

                <!-- Login Form -->
                @using (Html.BeginForm(new { returnUrl = ViewBag.ReturnUrl }))
                {
                    @Html.HiddenFor(m => m.TimeZone)

                    <div class="mb-3">
                        <label for="UserName" class="form-label">Username</label>
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @placeholder = "Enter your username" })
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label">Password</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Enter your password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe">
                            <label class="form-check-label" for="rememberMe">Remember for 30 days</label>
                        </div>
                        <a href="@Url.Action("ForgotPassword","Account")" class="forgot-password">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary">Sign in</button>

                    <button type="button" class="btn btn-google">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" alt="Google" width="18" height="18" class="google-icon">
                        Sign in with Google
                    </button>

                    <div class="signup-text">
                        Don't have an account? <a href="#" class="signup-link">Sign up</a>
                    </div>
                }
            </div>
        </div>
    </div>

    @Scripts.Render("~/Content/inc/jquery/jquery-2.1.0.min.js")
    @Scripts.Render("~/Scripts/jstz-1.0.4.min.js")

    <script>
        function fnSetTimezone() {
            var tz = jstz.determine();
            var timezone = tz.name();
            $("#TimeZone").val(timezone);
        }

        $(document).ready(function () {
            fnSetTimezone();

            var alertElement = $(".alertmsg");
            if (alertElement.length) {
                setTimeout(function () { alertElement.fadeOut(500); }, 5000);
            }
        });
    </script>
</body>
</html>